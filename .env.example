# ── GitHub ────────────────────────────────────────────────────────
# Personal Access Token (classic) with `repo` scope.
# Generate at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret string you set when creating the GitHub webhook.
# Used to verify X-Hub-Signature-256 (HMAC-SHA256).
WEBHOOK_SECRET=your-webhook-secret-here

# ── Groq LLM API ─────────────────────────────────────────────────
# Free-tier API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use on Groq (default: llama-3.1-70b-versatile)
GROQ_MODEL=llama-3.1-70b-versatile

# ── Server ────────────────────────────────────────────────────────
# Port the FastAPI server binds to (Railway injects $PORT automatically)
PORT=8000

# ── ChromaDB ──────────────────────────────────────────────────────
# Directory where ChromaDB persists its data
CHROMA_PERSIST_DIR=./chroma_data

# ── Logging ───────────────────────────────────────────────────────────────────
# Python log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ── Grafana ───────────────────────────────────────────────────────────────────
# Password for the Grafana admin user (default: changeme — change in production)
GRAFANA_PASSWORD=changeme

# ── Railway deployment ────────────────────────────────────────────────────────
# Full URL of your Railway deployment — used by the CI verify job
# Example: https://ai-code-reviewer-production.up.railway.app
RAILWAY_APP_URL=https://your-app.up.railway.app

